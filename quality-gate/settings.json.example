// settings.json.example — configuración del quality gate (copiar a settings.json).
// NOTA: settings.json se lee con JSON estricto; borra estos comentarios (//) al
// copiar, o el loader descartará la configuración en silencio.
{
  "project": {
    "app_root": ".",
    // require_branch: lista de ramas en las que el gate puede correr. Si la rama
    // actual no está listada, qg run / qg run-skill se bloquean (exit INFRA) antes
    // de ejecutar cualquier herramienta. Un string suelto se normaliza a una lista
    // de un elemento. Guarda de ejecución: nunca influye en el veredicto PASS/FAIL.
    "require_branch": ["main", "dev"],
    // require_clean: true bloquea el run si el working tree tiene cambios sin
    // commitear. Solo el booleano literal true la activa (el string "false" no).
    "require_clean": false,
    "sandbox": {
      // health_path: ruta que k6 valida contra BASE_URL (default /health).
      "health_path": "/health",
      // env: variables inyectadas como environment del contenedor app en el
      // sandbox de integración (sandbox/docker-compose.yml + override).
      "env": {
        "DATABASE_URL": "postgresql+asyncpg://postgres:change-me@postgres:5432/app"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(qg init:*)",
      "Bash(qg discover:*)",
      "Bash(qg setup:*)",
      "Bash(qg run:*)",
      "Bash(qg run-skill:*)",
      "Bash(qg get-profile:*)",
      "Bash(qg get-results:*)",
      "Bash(qg get-report:*)",
      "Bash(qg status:*)",
      "Bash(qg cleanup:*)"
    ],
    "deny": ["Bash(docker:*)", "Bash(git push:*)"]
  }
}
